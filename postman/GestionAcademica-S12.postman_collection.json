{
  "info": {
    "name": "Gestión Académica – Sesión 12",
    "description": "Pruebas del contrato de la API usado por el frontend React. Ejecutar primero 'Login ADMIN': guarda el token en la variable {{token}}.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:9090/api/v1" },
    { "key": "token", "value": "" },
    { "key": "tokenEstudiante", "value": "" }
  ],
  "item": [
    {
      "name": "1. Login ADMIN",
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('200 OK', () => pm.response.to.have.status(200));",
              "pm.collectionVariables.set('token', pm.response.json().accessToken);"
            ]
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"Admin12345\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "2. GET estudiantes (con token)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.test('Es un arreglo', () => pm.expect(pm.response.json()).to.be.an('array'));"] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/estudiantes"
      }
    },
    {
      "name": "3. GET estudiante por id (detalle)",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/estudiantes/1"
      }
    },
    {
      "name": "4. GET carreras",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));"] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/carreras"
      }
    },
    {
      "name": "5. GET estudiantes SIN token → 401",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('401 Unauthorized', () => pm.response.to.have.status(401));"] } }],
      "request": { "method": "GET", "header": [], "url": "{{baseUrl}}/estudiantes" }
    },
    {
      "name": "6. GET estudiante inexistente → 404",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('404 Not Found', () => pm.response.to.have.status(404));"] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/estudiantes/999"
      }
    },
    {
      "name": "7. Login ESTUDIANTE",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('200 OK', () => pm.response.to.have.status(200));", "pm.collectionVariables.set('tokenEstudiante', pm.response.json().accessToken);"] } }],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"estudiante1\",\n  \"password\": \"Estudiante123\"\n}" },
        "url": "{{baseUrl}}/auth/login"
      }
    },
    {
      "name": "8. GET estudiantes con rol ESTUDIANTE → 403",
      "event": [{ "listen": "test", "script": { "type": "text/javascript", "exec": ["pm.test('403 Forbidden', () => pm.response.to.have.status(403));"] } }],
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{tokenEstudiante}}" }],
        "url": "{{baseUrl}}/estudiantes"
      }
    }
  ]
}
